{
  "manifest_version": 3,
  "name": "Job Tracker - Juan",
  "version": "2.0",
  "description": "Captura vacantes de LinkedIn, El Empleo, Computrabajo, Himalayas y Magneto",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://*.elempleo.com/*",
    "https://co.computrabajo.com/*",
    "https://himalayas.app/*",
    "https://www.magneto365.com/*",
    "https://script.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://*.elempleo.com/co/ofertas-trabajo/*",
        "https://*.elempleo.com/co/JobOffers/*",
        "https://co.computrabajo.com/*",
        "https://himalayas.app/companies/*/jobs/*",
        "https://www.magneto365.com/co/empleos/*"
      ],
      "js": ["content.js"]
    }
  ]
}
